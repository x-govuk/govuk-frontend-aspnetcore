<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>$(LibTfms)</TargetFrameworks>
    <!-- xunit.v3 hosts the tests itself -->
    <OutputType>Exe</OutputType>
    <LangVersion>14.0</LangVersion>

    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hosts Razor Pages in TestApp/, so tests run over the markup the tag helpers render -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GovUk.Frontend.AspNetCore.Testing\GovUk.Frontend.AspNetCore.Testing.csproj" />
    <ProjectReference Include="..\..\src\GovUk.Frontend.AspNetCore.Testing.Xunit.v3\GovUk.Frontend.AspNetCore.Testing.Xunit.v3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The package adds this through buildTransitive, which a ProjectReference doesn't import -->
    <Using Include="GovUk.Frontend.AspNetCore.Testing.Xunit" />
  </ItemGroup>

</Project>
