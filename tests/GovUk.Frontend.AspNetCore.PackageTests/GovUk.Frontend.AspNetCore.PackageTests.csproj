<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- These tests drive the SDK as a child process, so the host only needs one TFM; the frameworks
         under test are a property of the generated fixture projects. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- xunit.v3 hosts the tests itself; the web SDK projects get this from their own defaults -->
    <OutputType>Exe</OutputType>

    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>xUnit1051</NoWarn>

    <PackageTestFeed>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'obj', 'test-feed'))</PackageTestFeed>
    <PackageTestPackages>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'obj', 'test-packages'))</PackageTestPackages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.10.5" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <!-- Deliberately no ProjectReference to the library: these tests must only ever see it through the
       package, since the packed layout is half of what's under test. -->
  <ItemGroup>
    <LibraryUnderTest Include="$(RepoRoot)src\GovUk.Frontend.AspNetCore\GovUk.Frontend.AspNetCore.csproj" />
  </ItemGroup>

  <!-- The fixture sources are copied into generated projects at test time; they're data here, not part
       of this assembly. -->
  <ItemGroup>
    <Compile Remove="Fixtures\**" />
    <None Remove="Fixtures\**" />
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The tests build throwaway projects against a real nupkg, so one has to exist before they run.
       Each commit packs a different version and the tests expect exactly one in the feed, hence the wipe. -->
  <Target Name="PackLibraryUnderTest" BeforeTargets="Build" Condition="'$(SkipPackLibraryUnderTest)' != 'true'">
    <!-- The extracted copy goes too; every pack of the same commit has the same version number, so otherwise
         the fixture projects would restore a stale package. -->
    <RemoveDir Directories="$(PackageTestFeed);$(PackageTestPackages)govuk.frontend.aspnetcore" />

    <!-- Build and pack are separate calls so that only one project instance ever builds the library.
         Properties passed here are global properties, so a Pack call with PackageOutputPath set is a
         different instance from the one the solution build uses; if both build, they race on the same
         bin/ and obj/ files and the build fails intermittently with "The process cannot access the
         file ... deps.json because it is being used by another process"
         (https://github.com/dotnet/sdk/issues/52477). The Build call passes no properties, so it shares
         this project's global properties and therefore the solution's instance of the library (or
         waits for it); the Pack call then only packages what that built. -->
    <MSBuild Projects="@(LibraryUnderTest)" Targets="Build" />

    <MSBuild Projects="@(LibraryUnderTest)"
             Targets="Pack"
             Properties="Configuration=$(Configuration);NoBuild=true;PackageOutputPath=$(PackageTestFeed)" />
  </Target>

  <ItemGroup>
    <AssemblyMetadata Include="PackageTestFeed" Value="$(PackageTestFeed)" />
    <AssemblyMetadata Include="RepoRoot" Value="$(RepoRoot)" />
  </ItemGroup>

</Project>
