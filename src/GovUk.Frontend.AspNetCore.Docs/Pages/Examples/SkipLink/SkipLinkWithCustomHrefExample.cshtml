@page

@* The skip link is visually hidden until focused; force the focused appearance so it can be captured. *@
<style>
    #skip-link-example .govuk-skip-link {
        position: static !important;
        width: auto !important;
        height: auto !important;
        margin: 0 !important;
        overflow: visible !important;
        clip: auto !important;
        clip-path: none !important;
        color: #0b0c0c !important;
        background-color: #fd0 !important;
        outline: 3px solid #fd0 !important;
    }
</style>

<example id="skip-link-example">
    <govuk-skip-link href="#main">Skip to main content</govuk-skip-link>
</example>
