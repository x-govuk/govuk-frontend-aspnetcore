<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xunit.v3 hosts the tests itself -->
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GovUk.Frontend.AspNetCore.Testing.Xunit.v3" Version="*-*" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Samples.ApplyForALibraryCard\Samples.ApplyForALibraryCard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="GovUk.Frontend.AspNetCore.Testing" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
