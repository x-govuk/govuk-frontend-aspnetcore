@page

<example>
    <govuk-panel class="govuk-panel--interruption">
        <panel-title>Is your age correct?</panel-title>
        <panel-body>
            <p class="govuk-body">You entered your age as <strong>109</strong>.</p>
        </panel-body>
        <panel-actions>
            <action type="button">Yes, this is correct</action>
